{
  "manifest_version": 3,
  "name": "Simple Screenshot Tool",
  "description": "Capture visible tab screenshots instantly",
  "version": "1.0",

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "tabs",
    "activeTab"
  ]
}